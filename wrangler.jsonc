{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-backlog",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Static site (Vite build output) is served directly; only /api/* hits the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // permanent store: last good sheet snapshot, runtime art lookups + images (free tier)
  "kv_namespaces": [{ "binding": "STORE", "id": "cf686d99bbbb491b9221b45b50155f00" }],
  // the site's home (custom domains on the Cloudflare zone); workers.dev keeps working too
  "workers_dev": true,
  "routes": [
    { "pattern": "the-backlog.games", "custom_domain": true },
    { "pattern": "www.the-backlog.games", "custom_domain": true }
  ],
  // days a newly added game wears its "NEW!" badge
  "vars": { "NEW_DAYS": "30" },
  "observability": { "enabled": true }
}
