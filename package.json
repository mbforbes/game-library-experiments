{
  "name": "the-backlog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "art": "bun scripts/art/build-art.ts",
    "art:review": "bun scripts/art/contact-sheets.ts",
    "deploy": "rm -rf dist && vite build && (set -a; [ -f .env.cloudflare-deploy ] && . ./.env.cloudflare-deploy; set +a; wrangler deploy)",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p worker && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/tilt-neon": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/bun": "^1.4.3",
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}