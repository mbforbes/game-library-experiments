# Cloudflare static asset caching. Everything here except the manifest and HTML has a content hash
# (or a version) in its name and never changes, so browsers and the edge keep it forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/audio/*
  Cache-Control: public, max-age=31536000, immutable
/art/atlas-*
  Cache-Control: public, max-age=31536000, immutable
/art/spines-*
  Cache-Control: public, max-age=31536000, immutable
/art/covers/*
  Cache-Control: public, max-age=31536000, immutable
/art/backs/*
  Cache-Control: public, max-age=31536000, immutable
/art/carts/*
  Cache-Control: public, max-age=31536000, immutable
/art/discs/*
  Cache-Control: public, max-age=31536000, immutable
/art/logos/*
  Cache-Control: public, max-age=31536000, immutable
/art/snaps/*
  Cache-Control: public, max-age=31536000, immutable
/art/spines/*
  Cache-Control: public, max-age=31536000, immutable
/art/manifest.json
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/og-*
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
