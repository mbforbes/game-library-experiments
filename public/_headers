# Cloudflare static asset caching. Art files and Vite bundles have content hashes in their
# names, so they can be cached forever; the manifest and HTML must revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/art/covers/*
  Cache-Control: public, max-age=31536000, immutable
/art/snaps/*
  Cache-Control: public, max-age=31536000, immutable
/art/atlas-*
  Cache-Control: public, max-age=31536000, immutable
/art/manifest.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
